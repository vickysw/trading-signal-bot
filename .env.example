# Copy this to .env and fill your values
# NEVER commit .env to git

# From Telegram BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...

# Channel or group ID
# Channel: -100xxxxxxxxxx  |  Group: -xxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# Passphrases — must match exactly what you set in TradingView indicator settings
# S2 Zone Pyramid indicator  → Settings → "5. Alerts" → "Webhook Passphrase"
S2_PASSPHRASE=your_s2_passphrase_here

# ICT ChoCH Signal indicator → Settings → "5. Alerts" → "Webhook Passphrase"
CHOCH_PASSPHRASE=your_choch_passphrase_here

# Server port (EC2 default 8000, or 80 with nginx)
PORT=8000
